{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avad",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "BOARDS", "id": "1c5e111a93d348fca5ceef0156ade48c" }
  ]
}
